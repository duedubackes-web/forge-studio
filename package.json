{
  "name": "forge-studio",
  "version": "0.2.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test",
    "agent:dev": "eve dev",
    "agent:build": "eve build",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "dependencies": {
    "@vercel/connect": "2.7.0",
    "ai": "^7.0.172",
    "eve": "1.0.0-rc.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.x",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "private": true,
  "description": "Original application-building platform foundation: local project planning, evidence and review.",
  "license": "MIT"
}
